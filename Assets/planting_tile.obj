# WaveFront OBJ file - Raised Planting Area Tile
mtllib Tile_Planting.mtl
o Tile_Planting

# --- 1. Đáy đế ngoài (Kích thước 6x6, Y = -0.1) ---
v -3.0000 -0.1000 -3.0000
v  3.0000 -0.1000 -3.0000
v  3.0000 -0.1000  3.0000
v -3.0000 -0.1000  3.0000

# --- 2. Đỉnh tường bồn (Y = 0.35 - 0.33 = 0.02, khoét ô giữa từ -2 đến 2) ---
v -3.0000  0.0200 -3.0000
v  3.0000  0.0200 -3.0000
v  3.0000  0.0200  3.0000
v -3.0000  0.0200  3.0000

v -2.0000  0.0200 -2.0000
v  2.0000  0.0200 -2.0000
v  2.0000  0.0200  2.0000
v -2.0000  0.0200  2.0000

# --- 3. Đáy lớp đất giữa (thụt 0.08 dưới đỉnh viền: Y = 0.02 - 0.08 = -0.06, dưới 0.12) ---
v -2.0000 -0.0600 -2.0000
v  2.0000 -0.0600 -2.0000
v  2.0000 -0.0600  2.0000
v -2.0000 -0.0600  2.0000


# --- Faces / Mesh Definition ---
g ConcreteBorder
usemtl ConcreteBorder
# 1. Đáy ngoài
f 1 2 3 4

# 2. Bốn mặt tường bên ngoài (từ đáy -0.1 lên đỉnh 0.02)
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

# 3. Mặt trên thành bồn (viền bê tông từ -3 đến -2 / 2 đến 3)
f 5 6 10 9
f 6 7 11 10
f 7 8 12 11
f 8 5 9 12

# 4. Bốn mặt tường trong lòng bồn (từ đỉnh 0.02 xuống đất -0.06)
f 9 10 14 13
f 10 11 15 14
f 11 12 16 15
f 12 9 13 16


g SoilMaterial
usemtl SoilMaterial
# 5. Lớp đất phẳng ở đáy lòng bồn (Y = -0.06)
f 13 14 15 16
