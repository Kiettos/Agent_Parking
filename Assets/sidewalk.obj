# WaveFront OBJ file - Sidewalk Tile with Grid Pattern
mtllib Tile_Sidewalk.mtl
o Tile_Sidewalk

# --- 1. Đế bê tông (Kích thước 6x6, cao độ -0.1 đến 0) ---
v -3.0000 -0.1000 -3.0000
v 3.0000 -0.1000 -3.0000
v 3.0000 -0.1000 3.0000
v -3.0000 -0.1000 3.0000
v -3.0000 0.0000 -3.0000
v 3.0000 0.0000 -3.0000
v 3.0000 0.0000 3.0000
v -3.0000 0.0000 3.0000

# --- 2. Các đường vân grid gạch trên bề mặt (Y = 0.000 đến 0.015) ---
# Đường dọc 1 (X từ -0.05 đến 0.05, Z từ -3 đến 3)
v -0.0500 0.0000 -3.0000
v  0.0500 0.0000 -3.0000
v  0.0500 0.0000  3.0000
v -0.0500 0.0000  3.0000
v -0.0500 0.0150 -3.0000
v  0.0500 0.0150 -3.0000
v  0.0500 0.0150  3.0000
v -0.0500 0.0150  3.0000

# Đường ngang 1 (Z từ -0.05 đến 0.05, X từ -3 đến 3)
v -3.0000 0.0000 -0.0500
v  3.0000 0.0000 -0.0500
v  3.0000 0.0000  0.0500
v -3.0000 0.0000  0.0500
v -3.0000 0.0150 -0.0500
v  3.0000 0.0150 -0.0500
v  3.0000 0.0150  0.0500
v -3.0000 0.0150  0.0500

# Đường phụ chia ô (Ví dụ: tại X = -2 và X = 2)
v -2.0500 0.0000 -3.0000
v -1.9500 0.0000 -3.0000
v -1.9500 0.0000  3.0000
v -2.0500 0.0000  3.0000
v -2.0500 0.0150 -3.0000
v -1.9500 0.0150 -3.0000
v -1.9500 0.0150  3.0000
v -2.0500 0.0150  3.0000

v  1.9500 0.0000 -3.0000
v  2.0500 0.0000 -3.0000
v  2.0500 0.0000  3.0000
v  1.9500 0.0000  3.0000
v  1.9500 0.0150 -3.0000
v  2.0500 0.0150 -3.0000
v  2.0500 0.0150  3.0000
v  1.9500 0.0150  3.0000

# --- Faces / Mesh Definition ---
g ConcreteBase
usemtl ConcreteBase
f 1 2 3 4
f 8 7 6 5
f 5 6 2 1
f 6 7 3 2
f 7 8 4 3
f 8 5 1 4

g GridLine
usemtl GridLine
# Vân dọc trung tâm
f 9 10 11 12
f 16 15 14 13
f 13 14 10 9
f 14 15 11 10
f 15 16 12 11
f 16 13 9 12

# Vân ngang trung tâm
f 17 18 19 20
f 24 23 22 21
f 21 22 18 17
f 22 23 19 18
f 23 24 20 19
f 24 21 17 20

# Vân phụ bên trái
f 25 26 27 28
f 32 31 30 29
f 29 30 26 25
f 30 31 27 26
f 31 32 28 27
f 32 29 25 28

# Vân phụ bên phải
f 33 34 35 36
f 40 39 38 37
f 37 38 34 33
f 38 39 35 34
f 39 40 36 35
f 40 37 33 36